# FocStepper 平台层配置 —— 跨项目复用
#
# 只放**与应用无关**的参数: 电机/传感器/通信/电源硬件/OTA。
# 应用策略参数 (助动力矩、保持时长、寻址 ID 等) 在 driver/main/Kconfig.projbuild。

menu "FocStepper 平台层"

    menu "电机与 FOC"

        config FOCSTEP_MOTOR_STEPS_PER_REV
            int "电机整步数/转"
            range 8 4096
            default 200
            help
                1.8° 混合式步进 = 200 步/转 (50 极对)。

        config FOCSTEP_POLE_PAIRS
            int "极对数 pp"
            default 50
            help
                StepperMotor(pp, ...) 的 pp 参数 = 整步数 / 4。
                1.8° 步进 (200 步/转) ⇒ pp = 50。
                ⚠️ 改电机时必须同步改这一项, 否则电角换算全错、initFOC 对齐失败。

        config FOCSTEP_PHASE_RESISTANCE
            string "相电阻 (Ω, 浮点)"
            default "1.2"
            help
                TorqueControlType::estimated_current 必需。
                **必须由上板 characteriseMotor() 实测**后回填 —— 出厂默认值只是占位,
                填错只影响力矩估算精度, 不会损坏硬件。

        choice FOCSTEP_TORQUE_CONTROL
            prompt "力矩控制类型"
            default FOCSTEP_TC_ESTIMATED

            config FOCSTEP_TC_VOLTAGE
                bool "voltage (电压模式, 最简)"
                help
                    直接给 q 轴电压。开环力矩, 不随温度/母线电压补偿。
                    没有任何前置条件, 最适合首次上板。

            config FOCSTEP_TC_ESTIMATED
                bool "estimated_current (模型估算, 默认)"
                help
                    Uq = i_q × phase_resistance + 反电动势。
                    **需要 FOCSTEP_PHASE_RESISTANCE 已实测回填** —— 没填会退回 voltage。
                    拿到电流环大部分收益, 且零额外硬件。

            config FOCSTEP_TC_FOC_CURRENT
                bool "foc_current (实测电流环, 用 IPROPI)"
                help
                    ⚠️ 实验性。双 PI 闭环 (d/q), 反馈来自 DRV8874 的 IPROPI 两路。

                    这条路是**可行的**(基类 CurrentSense 已内建步进分支, 两相免 Clarke),
                    但有本质缺陷, 上板前请读 ipropi_current_sense.h 的"已知限制":
                      · **IPROPI 无符号** ⇒ 符号靠指令方向重建, **过零点附近有死区**
                      · 符号有 1 个 FOC 周期滞后
                      · 两相非同时采样 (~40µs 偏差)
                      · AERR ±6% (1–2A 档), <0.4A 有固定偏置 ⇒ 传感器偏粗
                      · 超过 ITRIP(≈1.494A) 读数被钳位不再上升

                    建议先用 voltage 跑通 FOC 与限位, 再切本项调电流环。
        endchoice

        config FOCSTEP_CURRENT_LIMIT
            int "电流上限 (mA)"
            default 1500
            help
                foc_current / estimated_current 的电流限幅。
                ⚠️ 必须 <= ITRIP (≈1.494A), 否则环会要求一个 DRV8874 给不出的电流。
                同时它也是 PID_current_d/q 的输出限幅 (updateCurrentLimit 会同步)。

        config FOCSTEP_PID_CURR_P
            string "电流环 P"
            default "0.2"
            help
                ⚠️ 出厂默认只是个保守起点。**必须上板整定**:
                先用小值, 看阶跃响应, 逐步加 P 到临界振荡再退一半。

        config FOCSTEP_PID_CURR_I
            string "电流环 I"
            default "20.0"

        config FOCSTEP_PID_CURR_D
            string "电流环 D"
            default "0.0"

        config FOCSTEP_PID_CURR_LPF
            string "电流环低通滤波时间常数 (s)"
            default "0.005"
            help
                反馈低通 (LPF_current_q/d)。IPROPI 的 10nF (τ=35µs) 已经滤过一次,
                这里再滤是为了压住钳位附近的读数跳变。太大将拖慢环。

        config FOCSTEP_VOLTAGE_LIMIT
            string "电压上限 (V, 浮点)"
            default "12.0"
            help
                motor.voltage_limit。必须 <= 母线电压 * 0.5 (符号-幅值驱动的物理上限),
                否则会出现电流反向不受控。24V 母线时建议 6~12V。

        config FOCSTEP_VELOCITY_LIMIT
            string "速度上限 (rad/s, 浮点)"
            default "20.0"

        config FOCSTEP_FOC_PERIOD_MS
            int "FOC 任务周期 (ms)"
            range 1 20
            default 1
            help
                1ms = 1kHz。上限由 I2C 读决定 (KTH5701 读一次约 150~250µs @400kHz),
                **不要指望更高** —— 再快也是被 I2C 卡住, 只会让 loopFOC 超时抖动。

        config FOCSTEP_PHEN_SWAPPED
            bool "交换 EN/PH 引脚 (仅原理图接反时救回)"
            default n
            help
                ⚠️ **正常打样不需要打开。**

                docs/doc.md 已定线: DRV8874 引脚名即 EN/IN1、PH/IN2,
                **EN 在 IN1 脚上、PH 在 IN2 脚上**; 本板 GPIO19/21 = IN1(EN)、
                GPIO20/22 = IN2(PH)。默认分支与原理图一致。

                PH/EN 模式下**只有 EN=0 是 Brake**。若原理图把两根接反,
                "先切 brake"会变成 "EN 仍为 1、PH=0" = 满压反转驱动 —— 唤醒瞬间猛冲。

                默认(关) = EN 认在 IN1 = GPIO19/21 (与原理图一致)
                打开     = EN 认在 IN2 = GPIO20/22 (接反救回, 不必重画板)

                验线方法: `brake` 命令 → 两相 EN 拉低后手转轴,
                应有明显阻尼且电机不主动转。

        config FOCSTEP_MOTION_DOWNSAMPLE
            int "位置/速度环降频比 (FOC 周期数)"
            range 1 20
            default 1
            help
                位置/速度环没必要跟 1kHz。设为 N 表示每 N 个 FOC 周期跑一次 move()。
                力矩环仍按 FOC 周期跑。

    endmenu

    menu "编码器 KTH5701"

        config FOCSTEP_ENCODER_I2C_ADDR
            hex "I2C 从机地址"
            default 0x68
            help
                KTH5701 地址 = 0x68 | (A1?2:0) | (A0?1:0), 即 0x68/0x69/0x6A/0x6B。
                由板上 A0/A1 跳线决定。参考实现用 0x68 (A1=A0=0)。
                ⚠️ 量产板若改跳线, 这里必须同步改; 可用 `dump` 自检命令扫出实际地址。

        config FOCSTEP_ENCODER_I2C_HZ
            int "I2C 时钟频率 (Hz)"
            default 400000
            help
                KTH5701 支持 100k/400k。400k 时一次读约 150~250µs。

        config FOCSTEP_ENCODER_DIRECTION
            int "角度方向"
            range -1 1
            default 1
            help
                1 = 正向; -1 = 取反。
                由磁铁的充磁方向与安装面决定, **必须上板用手转轴确认**
                (自检: 正转时角度应单调增; 若反了改这里, 不要去改接线)。

        config FOCSTEP_ENCODER_ZERO_OFFSET
            string "零位偏置 (rad, 浮点)"
            default "0.0"
            help
                机械零位到电气零位的偏移。initFOC() 会自动对齐电气角,
                本项只用于让 sensor 的 0 对准机构 0 (推拉门的"全关"位置)。

        # ⚠️ 行程只有一个来源: **标定** (零点 + 满行程点, 存 NVS)。
        #    未标定时 foc_motor_move_to() 直接拒绝执行 —— 任何占位角都与真实机构无关,
        #    照它跑等于用错误基准冲机械限位。

        config FOCSTEP_ENCODER_WAKE_DIFF
            hex "Wake-up&Sleep 变化阈值寄存器值"
            default 0x0
            help
                KTH5701 在 Wake-up&Sleep 档下, 被测项变化超过阈值即拉高 INT。
                **这就是"手拉灵敏度"** —— 直接决定多小的门位移能唤醒。
                0 = 使用芯片上电默认, 不覆写。
                ⚠️ 具体寄存器号与量纲待上板用 `dump` 自检裁决 (见 docs/doc.md §九 待核实 #1)。

        config FOCSTEP_ENCODER_REG_INIT
            bool "上电写入参考寄存器初始化序列"
            default y
            help
                写入 reg 0x1C=0x1636 / 0x1D=0x0002 / 0x1E=0x8000。
                ⚠️ 这组值来自 GPL 参考实现 (在真板上跑通), 但与本项目从数据手册
                记下的寄存器号**冲突**。上板第一件事是用自检命令回读比对裁决。
                若关掉本项, 芯片用上电默认值。

    endmenu

    menu "电流采样 (IPROPI)"

        config FOCSTEP_ADC_ATTEN_DB
            int "ADC 衰减 (dB)"
            range 0 12
            default 12
            help
                12dB ⇒ 量程约 0~3.1V。IPROPI 在 1.5A 档 (VREF=2.35V) 时对应电压
                ≈2.35V 并被 VREF 钳位, 必须用 12dB 否则量程不够。

        config FOCSTEP_R_IPROPI_OHM
            int "R_IPROPI (Ω)"
            default 3480
            help
                每片 DRV8874 一颗, 对地 1%。将 IPROPI 电流转成电压供 ADC 读取。

        config FOCSTEP_A_IPROPI_UA_PER_A
            int "A_IPROPI (µA/A)"
            default 450
            help
                电流镜缩放系数。
                ⚠️ DRV8874 数据手册**正文写 450、应用示例写 455**, 自相矛盾。
                默认按正文 450; **上板用万用表比对后按实测标定**。

        config FOCSTEP_ITRIP_MA
            int "设计斩波阈值 ITRIP (mA)"
            default 1500
            help
                **这是 ITRIP 的唯一真源**: 固件按本值算出 MCP4725 该输出多少伏
                (VREF = ITRIP × R_IPROPI × A_IPROPI) —— 唤醒接管档、运行档、
                自检提示的"可测上限"全部由它推导, 代码里不另存一份档位常量。
                doc.md §5.4 档位表: 0.3A→0.47V / 1.0A→1.57V / 1.5A→2.35V /
                1.8A→2.82V; VREF≥3.0V 后 DRV 内部钳位 (封顶 1.915A),
                固件 clamp ≤1.85A。

                ⚠️ 本值同时就是 IPROPI 的**可测上限** (引脚被 DRV 钳在 V_VREF 上)
                ⇒ FOCSTEP_STALL_CURRENT_MA 与 FOCSTEP_CURRENT_LIMIT 都必须 ≤ 本值,
                否则它们要求的电流驱动板永远给不出。

        config FOCSTEP_STALL_CURRENT_MA
            int "堵转判定电流 (mA, 矢量幅值)"
            default 1200
            help
                判据是**电流矢量幅值 √(ia²+ib²)** 的峰值, 持续超过本值 stall_ms
                即判堵转/堵门。

                ⚠️ 不要用单相瞬时值 —— 稳态下 ia=I·cosθ、ib=I·sinθ, 单相值随电角度在
                0.707·I ~ I 之间摆动, 拿去比阈值会让"持续时间"条件永远凑不满,
                一次都触发不了。

                ⚠️ 因为 VIPROPI 被钳位到 V_VREF, **可测上限就是 FOCSTEP_ITRIP_MA**,
                不再上升 ⇒ 只能判"到顶", 不能测幅值。故本值**必须 < ITRIP**。
                整定方法: 先跑 normal 负载记录稳态峰值, 取其 1.5~2 倍。

        config FOCSTEP_POS_TRUST_TOL_MRAD
            int "位置可信度容差 (mrad)"
            range 1 6283
            default 30
            help
                深睡存盘时的单圈角与唤醒后读到的单圈角之差超过本值, 就判定
                "睡着时被动过" ⇒ 多圈计数不可信, 需要回零。

                默认 30 mrad ≈ 0.03 rad ≈ 0.005 圈。取小的理由是:
                **误判为"没动"的代价 (冲错位置) 远大于误判为"动过" (多跑一次回零)**。

                ⚠️ 根本歧义无法消除: 只有单圈绝对传感器, 分不清"动了 0.3 圈"与
                "动了 1.3 圈" —— 单圈读数一样。所以只要超出容差就一律回零。

        config FOCSTEP_HOME_TORQUE_MV
            int "回零力矩 (mV)"
            range 200 12000
            default 800
            help
                ⚠️ **回零必须用小力矩** —— 以运行力矩顶机械限位会损坏机构。
                注意"力小"和"速度慢"是两回事: 本实现限的是**电压上限** (决定力矩),
                不是把速度调慢。慢速大力同样会顶坏东西。

                ⚠️ **这个值还直接决定"电流抬升"判据有没有动态范围**:
                  自由运行电流 ≈ 力矩 / 相电阻。以 R=1.2Ω 为例:
                    1500mV → 1.25A, 到钳位 1.494A 只剩 1.19×  ⇒ 判据几乎不可用
                     800mV → 0.67A, 余量 2.23×               ⇒ 良好
                     600mV → 0.50A, 余量 2.98×               ⇒ 更好
                所以**力矩越小, 接触检测越灵敏**, 同时还更保护机构 —— 两边同向。

        config FOCSTEP_HOME_BASELINE_MS
            int "自由运行电流基线采样时长 (ms)"
            range 100 3000
            default 400
            help
                开始逼近后先跑这么久, 取这段时间的电流峰值作为**基线**,
                后续的"接触"靠"电流相对基线抬升"判定。
                (对比: TMC2209 StallGuard 也必须绑定一个速度标定阈值)

        config FOCSTEP_HOME_RISE_PCT
            int "接触判据: 电流相对基线抬升 (%)"
            range 110 400
            default 160
            help
                电流峰值超过基线这么多即认为接触。默认 160% (1.6×)。
                太小会被机构摩擦波动误触发; 太大则接触后要顶很久才判出。

        config FOCSTEP_HOME_MIN_CURRENT_MA
            int "基线可用下限 (mA)"
            range 50 2000
            default 150
            help
                基线低于本值就认为电流信号不可用 (未使能/标定错), 自动关掉
                "电流抬升"判据, 只靠位置停滞判定。

        config FOCSTEP_HOME_MAX_TRAVEL_MRAD
            int "单次逼近最大行程 (mrad)"
            range 1000 500000
            default 60000
            help
                朝一端最多推多远就该碰到限位。超过即判 HOME_ERR_NO_CONTACT。
                这个值必须**大于实际行程**, 但要尽量小 —— 它是失控时的保护。
                60 rad ≈ 9.5 圈 (200步/转 的 42 步进)。

        config FOCSTEP_HOME_BACKOFF_MRAD
            int "接触后退避距离 (mrad)"
            range 10 5000
            default 300
            help
                碰到限位后往回退一点, 松开机械限位 —— 避免长期顶住导致变形/发热。

        config FOCSTEP_HOME_CONFIRM_MS
            int "接触确认时间 (ms)"
            range 100 3000
            default 500
            help
                "位置不再前进 **且** 电流抬升"需持续这么久才判定接触。
                太小会被 PWM 周期抖动误触发; 太大则回零变慢。

        config FOCSTEP_HOME_REPEAT_TOL_MRAD
            int "重复性容差 (mrad)"
            range 1 500
            default 20
            help
                两次逼近的接触点之差超过本值即判 HOME_ERR_UNREPEATABLE。
                **这一步不能省** —— 偏一步的基准会让机构永远偏, 而且现场很难发现。

        config FOCSTEP_HOME_TIMEOUT_MS
            int "单端回零总超时 (ms)"
            range 2000 300000
            default 30000

        config FOCSTEP_HOME_RETRY
            int "标定失败重试次数"
            range 0 5
            default 1
            help
                **两端标定** (`learn both` / 自动标定) 一次失败后重跑几轮, 0 = 不重试。
                默认 1 (最多做两轮): 偶发的接触判据抖动值得再试一次, 但**重试也不能多** ——
                每轮都会让门顶两次机械限位, 轮数多只增加磨损, 不会让卡住的机构变通。
                只测不改行程的命令 (`home`) 与只写不动的落定 (`learn zero|end` / `mark`) 不重试:
                前者没有"成功"可言, 后者不动电机, 都没有可重试的东西。

        config FOCSTEP_HOME_AUTO_INVERTED
            bool "自动标定: 零点在正端 (反装机构)"
            default n
            help
                自动标定是**无人值守**的, 没人能告诉它"哪一侧是零点" ——
                而标定前"哪一侧是零点"恰恰是**待求量**, 推不出来 ⇒ 只能配。
                默认 n = 零点在负端 (常规安装, 等价 `learn both neg`)。
                反装机构 (零点的角度比满行程点更大) 打开本项 = `learn both pos`。
                人在现场时不必动它, 直接敲 `learn both pos|neg` 更清楚。

        config FOCSTEP_HOME_AUTO_ENABLE
            bool "允许无人值守自动标定"
            default n
            help
                ★ 默认**关**。打开它意味着固件可以在**没有任何人在场**的情况下让门自己
                跑到底顶机械限位 —— 装歪、卡住、有人扶着门时都可能出事实伤害。
                所以出厂必须关, 由现场人员确认机构通畅后再打开 (或运行时用
                homing_set_policy() 授权)。手动命令 (`learn` / `mark`) 不受本项限制:
                那是人在现场下发的。

        config FOCSTEP_STALL_MS
            int "堵转判定持续时间 (ms)"
            range 10 5000
            default 300

    endmenu

    menu "母线电压采样"

        config FOCSTEP_VBUS_DIVIDER_NUM
            int "分压比分子 (下臂, Ω)"
            default 8200

        config FOCSTEP_VBUS_DIVIDER_DEN
            int "分压比分母 (上臂+下臂, Ω)"
            default 108200
            help
                100k + 8.2k ⇒ 比值 = 8.2/(100+8.2) = **0.0758**。
                覆盖 **6.0~25.2V (2S~6S)**: 6.0V→0.455V, 25.2V→1.91V, 30V→2.27V。
                ⚠️ **ADC 引脚前另串 4.7k (R6)**, 建立时间算的是
                (100k∥8.2k + 4.7k) × 1nF = 12.3µs —— 但**分压比不含它**
                (串阻在 ADC 引脚侧, 引脚漏电流为 nA 级 ⇒ 不产生压降)。
                ⚠️ 瞬态过压时 `ADC 节点 = VM × 0.0758` 会超引脚额定
                (VM ≥ 47.5V 时节点 ≥ 3.6V), 见 doc.md §五.1。

        config FOCSTEP_VBUS_GATE_SETTLE_US
            int "门控导通后等待 (µs)"
            range 62 5000
            default 70
            help
                **拓扑 (doc.md §5.1)**: GPIO7 → 恒流下沉 (Q3 MMBT5551 + Re 33k)
                → Q2 (BSS84) 栅极。Vgs 恒定 **−7.9V 与母线无关**
                ⇒ 支持 **6.0~25.2V 宽压 (2S~6S)**。

                建立时间 = max(Q2 栅极 5µs, 分压 5τ)。分压源阻抗
                (100k∥8.2k = 7.6kΩ) + ADC 串阻 4.7k = 12.3kΩ, ×1nF ⇒ τ=12.3µs,
                5τ ≈ 62µs ⇒ **取 70µs**。

                ⚠️ **导通时间直接决定待机开销**: 导通期间分压吸
                VM/108.2k ≈ 233µA @25.2V, 恒流下沉栅极支路再吸 **79µA**
                ⇒ **合计 312µA**。@100Hz + 70µs ⇒ 平均 **2.2µA@25.2V**
                (doc.md §六 取 ≈2.1µA)。**若导通 2ms ⇒ 62µA, 差 28 倍。**
                ⇒ 本项**必须走 µs 级忙等, 不能用 vTaskDelay**
                (CONFIG_FREERTOS_HZ=1000 时 delay 最小就是 1ms, 下不去)。

                ⚠️ 门控只允许做在**高边**。若开关串在 8.2k 下方, 关断时上臂会把
                ADC 节点抬到 VM 电位, 超引脚耐压并有损伤风险。

        config FOCSTEP_VBUS_GATE_ACTIVE_HIGH
            bool "门控高有效"
            default y
            help
                GPIO7 输出高 → NPN 恒流下沉导通 → Q2 栅极被拉低 → P-MOS 导通
                → 分压接入。
                ⚠️ 配错会导致常态耗 5.3mW, 推翻深睡档待机基线 (25~65µA@24V)。
                上板第一件事: ① 门控关断时量 ADC 节点应为 0V (被 8.2k 拉到地);
                ② 门控导通时量 Q2 的 Vgs, 6S 档应 ≈ **−7.9V**、2S 档按
                doc.md §5.1 的工作点表 (2S 档 Q3 饱和, Vgs 随母线自动给足)。

        config FOCSTEP_VBUS_MIN_ENABLE_MV
            int "禁止使能电机的母线下限 (mV)"
            default 5400
            help
                §10.4 安全逻辑①: VM < 阈值禁止使能电机。

                **定 5400 的依据 (宽压 6.0~25.2V, doc.md §9.2 #25)**:
                - 下界: USB 单独供电 VM≈4.6V (逼近 DRV8874 下限 4.5V) ⇒ 必须挡
                - 上界: 2S 锂电放电截止恰好 **6.0V** ⇒ 不能高过它
                - 取 **5400**: 距 USB 有 0.8V 余量, 距 2S 截止有 0.6V 余量
                ⚠️ 取 6000 会与 2S 截止重合 ⇒ 满放时电机被禁, 且**对 ADC 误差
                零余量** (低压端折算误差 ±0.06~0.13V 就能把 6.0V 判成"空")。
                ⚠️ 低压端 ADC 节点 0.35~0.46V 是 ESP32 ADC **相对精度最差**的
                区域, 本阈值仍须与实测精度一起复核 (doc.md §9.2 #24)。

    endmenu

    menu "CAN 总线"

        config FOCSTEP_CAN_ENABLE
            bool "启用 CAN (⚠️ 会顶掉 UART0 的 4P 调试口)"
            default n
            help
                ⚠️ **这个开关不是"开/关一个功能", 而是"选哪一档"** —— 因为 TWAI 与
                UART0 抢占**同一对 GPIO16/17** (收发器与 4P 调试排针共用, docs/doc.md §5.3):

                  关闭 (**默认, 调试档**): UART0 控制台在 GPIO16/17 ⇒ **4P 排针可用**,
                                           CAN 不工作。此时收发器的 RXD 仍挂在 GPIO17 上
                                           (靠那颗 1.5kΩ 隔离, 见 §5.3)。

                  打开 (CAN 档):  TWAI 占用 GPIO16/17 ⇒ **必须同时把控制台改到
                                  USB-Serial-JTAG**, 否则日志出不去:
                                    CONFIG_ESP_CONSOLE_UART_DEFAULT=y
                                      → CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
                                    CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=n → y
                                    + CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y

                ⇒ **两档是配套的, 只改一半会得到"日志消失"或"CAN 不通"。**
                建议再加 CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y,
                这样默认档下 Type-C 也能看日志 (只读镜像), 不必来回换档。

                完整依据、代价与使用纪律见 docs/doc.md §5.3。

        config FOCSTEP_CAN_BITRATE
            int "CAN 波特率 (bit/s)"
            default 500000
            help
                ⚠️ **docs/doc.md 尚未定 CAN 波特率** —— 500k 是占位值, 已列为
                **§9.1 #3 待拍板**。需按线长 / 节点数 / 板载终端形式 (分裂 2×60Ω) 定稿。

        config FOCSTEP_CAN_NO_ACK
            bool "TWAI 无 ACK 模式 (单板 bring-up)"
            default n
            help
                打开后 TWAI 进入 NO_ACK 模式: 总线上没有其他节点回 ACK 时也能发出帧。
                **只在单板台上调试时打开** —— 正式组网必须关掉, 否则总线错误计数不生效、
                丢帧检测失去意义。

        config FOCSTEP_CAN_NODE_ID
            int "本节点 CAN ID 基址"
            range 1 2047
            default 16

        config FOCSTEP_CAN_TIMEOUT_MS
            int "CAN 丢帧超时 (ms)"
            range 100 60000
            default 3000
            help
                §10.4 安全逻辑④: 超时未收到主站帧 ⇒ 上报故障码 4。
                不影响本地控制 (手拉助动仍然工作)。

    endmenu

    menu "指示灯"

        config FOCSTEP_WS2812_ENABLE
            bool "启用 WS2812"
            default y
            help
                亮度**不在 Kconfig**: led_indicator 对 RGB 步没有全局亮度缩放
                (每次 RGB 步都会整体覆盖内部的 IHSV 值), 唯一生效的限幅是
                led_ws2812.c 里那几个小数值的 RGB 宏。
                ⚠️ **禁全白**: 单颗全白约 60mA, 会瞬间拉垮 Buck。

    endmenu

    menu "联网与 OTA"

        config FOCSTEP_WIFI_ENABLE
            bool "启用 Wi-Fi 控制面 (HTTP/OTA)"
            default n
            help
                睡眠态不启用 (会打破深睡)。仅在平台态调试时打开。

        config FOCSTEP_WIFI_SSID
            string "Wi-Fi SSID"
            default ""
            help
                凭据**不进版本库**。真实值写在 sdkconfig.defaults.local
                (已 gitignore, 由 CMakeLists.txt 自动追加)。

        config FOCSTEP_WIFI_PASSWORD
            string "Wi-Fi 密码"
            default ""

    endmenu

    menu "低功耗与唤醒"

        config FOCSTEP_WAKE_ON_ENCODER
            bool "编码器 INT 唤醒 (ext1)"
            default y
            help
                KTH5701 INT 接 GPIO3 (LP 域)。数据手册: 高有效、**锁存**,
                **读一次数据即清零**。⇒ ext1 配 ESP_EXT1_WAKEUP_ANY_HIGH。
                ⚠️ 若上板实测"读数据不清 INT", 则必须改走轮询, 深睡档不成立 ——
                这是 §10.3 的地基, 见上板自检第 10 项。

        config FOCSTEP_PA_WAKE_ENABLE
            bool "无线唤醒接收 (BLE 周期广播 / PA)"
            depends on BT_ENABLED
            default y
            help
                把 PA 接收端编进固件: 驱动板可被无线发送端远程唤醒/开/关/停。
                实测成本模型 I_RX = f + 0.160/T (C6, 见 tests/ble_sync), 详见
                code/README.md §13。

                ⚠️ 三件事必须一起看:
                  · 会引入 BLE 协议栈 (flash/RAM 增量)。上板前用 `idf.py size`
                    核对仍能装进 TWO_OTA_LARGE 分区。
                  · **与 FOCSTEP_SLEEP_MODE_LIGHT 互斥** —— 监听期必须让 BLE
                    控制器自己排唤醒 (PM 自动轻睡), 显式 esp_light_sleep_start()
                    与它不共存 (IDF 对"BT 未停时手动轻睡"是受限用法)。
                  · 板级硬前提: **32.768kHz 晶振** + `RTC_CLK_SRC_EXT_CRYS=y`
                    (sdkconfig) + `BT_LE_LP_CLK_SRC_DEFAULT=y`。少了它们要么
                    同步不稳, 要么白丢 3.33mA。

        config FOCSTEP_PA_WAKE_T_MS
            int "无线唤醒周期 T (ms, 上电期望值)"
            range 100 60000
            default 500
            help
                监听端的"功耗-时延"旋钮: T = per_adv_ival × (skip+1), 最坏响应 ≈ T。
                实际值只能落在发射端间隔的整数倍上 (发射端 240ms 时, T=500 实得 480ms),
                命令 `wake status` 会打印实得值。
                ⚠️ 发送端可用 SET_T 指令动态改 (它的陀螺仪快/慢档), 这里只是上电初值。

        config FOCSTEP_PA_TICK_MS
            int "监听期主循环节拍 (ms)"
            range 50 5000
            default 1000
            help
                监听期主循环周期。⚠️ **不能沿用 100ms**: 每次唤醒都要付 BLE 控制器
                固定的轻睡退出开销 (实测常数 ~3.2ms × ~50mA), 100ms 节拍会把省电全吃掉。
                代价: 监听期本地手拉唤醒的检测延迟 ≤ 本值 (可用 GPIO 中断改善, 待验证)。

        config FOCSTEP_PA_SCAN_WINDOW_MS
            int "发现扫描的窗口 (ms, 快扫相位)"
            range 10 1000
            default 60
            help
                ⚠️ 发现期扫描必须**限占空比**: 若把 window 设成等于 interval (=100%),
                发射端不在场时就是射频常开 (~84mA), 把监听期的省电全部吃掉。
                实测占空比 = window/interval 即为平均电流的倍数基准。

        config FOCSTEP_PA_SCAN_INTERVAL_MS
            int "发现扫描的间隔 (ms, 快扫相位)"
            range 20 5000
            default 300

        config FOCSTEP_PA_SCAN_FAST_MS
            int "快扫持续时长 (ms), 超时转慢扫"
            range 2000 600000
            default 30000
            help
                发射端在场时几十毫秒就能发现, 所以先快扫一段时间保证响应;
                超时说明对端不在, 转"慢扫"(30ms/10000ms ≈ 0.3%, 亚 mA 级):
                代价是发现延迟变长, 换来持续电流降到亚 mA 级。

        config FOCSTEP_SLEEP_ENABLE
            bool "允许进入睡眠档 (PS_SLEEP)"
            default y
            help
                允许主循环在 PS_SLEEP 态让 MCU 睡下去。关掉只用于台面调试
                (例如要一直连着串口看日志、或反复打断睡眠做测量)。
                用哪种睡眠由下面 FOCSTEP_SLEEP_MODE 决定。

        choice FOCSTEP_SLEEP_MODE
            prompt "睡眠档的 MCU 模式"
            default FOCSTEP_SLEEP_MODE_DEEP
            help
                板级"深睡"(power_state = PS_SLEEP) 用哪种 MCU 睡眠实现。
                两者对控制脚的取值要求完全相同 —— **真变量只有 nSLEEP(GPIO18) 一根**:
                CAN 的 Rs 挂在这根线的硬件派生网络上 (§5.3), 而灯带的"灭"靠固件发全黑
                而非控制线 (§五.2), 所以 §10.3 那张表的控制脚列只剩它一个,
                差别全在 MCU 侧 (docs/doc.md §5.6 / §10.3):

                - DeepSleep: 功耗最低 (~10µA), 唤醒即复位 ⇒ 从 app_main 重跑,
                  位置靠 NVS 恢复; GPIO 浮空 ⇒ 靠外部上下拉维持安全电平。
                - LightSleep: 唤醒不复位 (GPIO 保持、RAM 保留、唤醒快),
                  **但待机电流高于 DeepSleep ⇒ §六 的深睡档口径 (25~65µA@24V) 要按实测重算**。
                  代码侧另有两条硬要求 (已实现, 见 foc_motor.h / wakeup.h):
                    · 醒来必须**读一次编码器数据清 INT 锁存**, 否则被同一次中断立刻重复唤醒;
                    · 唤醒后要重做"位置是否可信"判定 (睡着期间可能被手拉动)。

            config FOCSTEP_SLEEP_MODE_DEEP
                bool "DeepSleep (功耗最低, 唤醒即复位)"

            config FOCSTEP_SLEEP_MODE_LIGHT
                bool "LightSleep (唤醒不复位, GPIO 保持)"
                depends on !FOCSTEP_PA_WAKE_ENABLE
                help
                    ⚠️ 与无线唤醒接收 (FOCSTEP_PA_WAKE_ENABLE) 互斥:
                    PA 监听期必须让 BLE 控制器自己排唤醒窗口 (PM 自动轻睡),
                    而本档走的是显式 esp_light_sleep_start(), 两者不共存
                    (IDF 对"BT 未停时手动轻睡"是受限用法)。
                    要用无线唤醒就保持 DeepSleep 档, 监听期由 app_main 的
                    "监听档"分支负责不进显式睡眠。
        endchoice

    endmenu

    menu "调试"

        config FOCSTEP_PLATFORM_CONSOLE_ENABLE
            bool "启用平台自检命令台"
            default y
            help
                注册**平台级**自检命令: id / regs / status / xyz / circle / cal /
                vref / brake / jog / align / char / ipropi / stall / vbus / gate /
                int / sleep。
                这些命令是硬件 bring-up 用的, 与具体应用无关。

                应用自己的命令在应用层用 platform_console_register() 注册,
                由应用的 Kconfig 单独开关。

        config FOCSTEP_LOG_LEVEL_VERBOSE
            bool "平台层详细日志"
            default n

    endmenu
endmenu
