# ---- 目标与 flash ----
CONFIG_IDF_TARGET="esp32c6"
# ESP32-C6-MINI-1 板载 4MB flash。不显式写的话 IDF 默认按 2MB 算,
# 而 two_ota_large 分区表要 3.5MB ⇒ 直接构建失败。
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# ---- ★ 必须: FreeRTOS 时基 1000Hz ----
# esp_simplefoc 的 README 明确要求。100Hz(默认)下 vTaskDelayUntil 的分辨率是 10ms,
# 1kHz 的 FOC 循环根本无法成立, 电机会有异响甚至失步。
CONFIG_FREERTOS_HZ=1000

# ---- CPU: C6 单核, 160MHz ----
# FOC 循环 + I2C 读 + ADC 读都在一个核上, 160MHz 留足余量。
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y

# ---- main 任务栈 ----
# esp_console + FOC 初始化 + C++ 对象构造都在 main 里, 默认 3.5KB 不够。
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# ---- 编译优化 ----
# FOC 是硬实时的, 用 -O2。
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# ---- 控制台: UART0 (经板载串口桥) ----
# 不用原生 USB-Serial-JTAG: ① 经 USJ 的复位会让 ROM 进下载模式; ② USJ 不支持轻睡(IDF-6395)。
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=n

# ---- 电源管理与 tickless ----
# ⚠️ 这两项**不会**自动开启轻睡: 还得调 esp_pm_configure({light_sleep_enable=true})
# 才会在空闲时自动轻睡。本工程**故意不启用自动轻睡** —— 1kHz 的 FOC 任务对时序敏感,
# "睡不睡"要由 PS_SLEEP 状态决定 (显式 esp_light_sleep_start(), 见 code/README.md §12),
# 不能是"谁闲着就睡"。保留 PM_ENABLE + tickless idle 是为了运行态降频/空闲,
# 以及将来真要开自动轻睡时不必改配置。
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=3
CONFIG_ESP_PHY_MAC_BB_PD=y
CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE=y

# ---- 深睡 ----
# 保留 RTC 域, 深睡时给 flash 掉电。
CONFIG_ESP_SLEEP_POWER_DOWN_FLASH=y

# ---- I2C ----
# ① i2c_bus 是 esp_simplefoc 传递拉进来的 (AS5600 支持), 它按**旧版** i2c_config_t
#    结构体写 (.master.clk_speed); 不开 BACKWARD_CONFIG 时 i2c_bus 会自带另一份
#    i2c_config_t, 与 driver/i2c.h 冲突。
#    ⚠️ 本工程的编码器与 DAC **都不走 i2c_bus**: 两者统一由 esp-idf-lib/i2cdev 建在
#       driver/i2c_master 之上 (见 components/focstep_platform/idf_component.yml)。
CONFIG_I2C_BUS_BACKWARD_CONFIG=y

# ② i2cdev 的每次事务自带 3 次重试 + 20/40/80ms 指数退避, 而单次超时默认 1000ms。
#    编码器读跑在 1kHz 的 FOC 环里 ⇒ 总线被拉低时最坏要阻塞约 4.3s, 控制环直接停摆。
#    压到区间下限 10ms (400kHz 下 3 字节事务远远够用) 后最坏停顿降到百毫秒量级。
CONFIG_I2CDEV_TIMEOUT=10

# ---- ADC ----
# IPROPI 在 1.5A 时约 2.36V, 必须 12dB 档 (0dB 量程只有 ~1.1V)。
CONFIG_ADC_ONESHOT_CTRL_FUNC_IN_IRAM=n

# ---- 分区表: 双 OTA ----
# 驱动板需要能远程升级 (门装好之后再拆板成本极高)。
CONFIG_PARTITION_TABLE_TWO_OTA_LARGE=y

# ---- 日志 ----
# ⚠️ 日志会占 CPU 与串口时间。默认 INFO; 定位 FOC 循环瓶颈时再临时开 DEBUG。
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ---- 无线唤醒接收 (BLE 周期广播 / PA) ----
# 依据 tests/ble_sync 的接收端归档配置 (configs/sdkconfig.defaults.sync-c6)。
# ⚠️ C6 用的是**新控制器**, 符号是 BT_LE_* / BT_NIMBLE_*;
#    写成旧控制器的 BT_CTRL_*/BTDM_* 会被 Kconfig **静默忽略**(不报错)。
# ⚠️ 改完必须 `rm -f sdkconfig` 再 build —— 已存在的 sdkconfig 不会回灌 defaults。
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# 只做观察者 (被动扫描 + 周期同步); 其余角色关掉省 flash/RAM
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
CONFIG_BT_NIMBLE_EXT_ADV=y            # 拉入扩展扫描 + 周期同步支持
CONFIG_BT_NIMBLE_MAX_PERIODIC_SYNCS=1
# 低功耗三件套:
#  · BT_LE_SLEEP_ENABLE: 缺它只有 modem sleep, 控制器根本不休眠
#  · RTC_CLK_SRC_EXT_CRYS: 板载 32.768kHz 晶振 (doc §5.5)。**不选它 RTC 慢时钟
#    就是内部 RC**: 既拿不到 ±20ppm, 也让下面那项失去意义
#  · BT_LE_LP_CLK_SRC_DEFAULT: BLE 低功耗时钟"跟随系统 RTC 慢时钟" = 上面那颗晶振。
#    比 MAIN_XTAL 省 3.33mA (实测), 且是控制器肯放开 NO_LIGHT_SLEEP 锁的前提
CONFIG_BT_LE_SLEEP_ENABLE=y
CONFIG_RTC_CLK_SRC_EXT_CRYS=y
CONFIG_BT_LE_LP_CLK_SRC_DEFAULT=y
CONFIG_PM_DFS_INIT_AUTO=y

# ---- BW20 (省 flash / RAM) ----
CONFIG_ESP_WIFI_ENABLED=n

# ---- 堆 ----
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=2304
